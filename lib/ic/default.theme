[theme]
frame_style=1
panel_shadow=0

panel_top_code=1;38;2;255;255;255;48;2;20;45;90
panel_body_code=38;2;220;230;255;48;2;20;45;90
panel_focus_code=1;38;2;0;0;0;48;2;170;225;255
panel_title_code=1;38;2;255;255;255;48;2;20;45;90
panel_marked_code=1;38;2;255;230;120;48;2;20;45;90
panel_marked_focus_code=1;38;2;220;0;0;48;2;170;225;255

menu_window_code=1;38;2;255;255;255;48;2;20;45;90
menu_focus_code=1;38;2;0;0;0;48;2;170;225;255

modal_anim_ticks=3

modal_copy_code=38;2;25;25;25;48;2;210;210;210
modal_overwrite_code=38;2;40;15;35;48;2;255;185;225
modal_frame_code=1;38;2;80;80;80;48;2;210;210;210
modal_text_code=38;2;25;25;25;48;2;210;210;210
modal_shadow_code=38;2;80;80;80;48;2;80;80;80

modal_field_code=38;2;20;20;20;48;2;245;245;245
modal_cursor_code=1;38;2;255;255;255;48;2;220;80;40
modal_focus_code=1;38;2;0;0;0;48;2;170;225;255
modal_button_code=1;38;2;20;20;20;48;2;235;235;235
modal_button_focus_code=1;38;2;0;0;0;48;2;170;225;255
viewer_goto_cursor_code=1;38;2;255;255;255;48;2;220;80;40
viewer_search_cursor_code=1;38;2;255;255;255;48;2;220;80;40

command_bar_code=1;38;2;20;25;30;48;2;170;225;255
command_bar_active_code=1;38;2;255;120;210;48;2;170;225;255
command_bar_disabled_code=38;2;120;120;120;48;2;170;225;255
command_line_code=38;2;220;230;255;48;2;20;45;90

###### new ###########
# Search dialog animation speed in ticks.
# 0 disables staged animation.
searchdialog_anim_ticks=3

# Search dialog root window background and default foreground.
# Applies to the dialog container node itself.
searchdialog_window_code=38;2;20;20;20;48;2;210;210;210

# Search dialog frame color.
# Applies to top, middle and bottom frame lines.
searchdialog_frame_code=1;38;2;80;80;80;48;2;210;210;210

# Search dialog normal text color.
# Applies to labels such as "Find:" and alert text.
searchdialog_text_code=38;2;25;25;25;48;2;210;210;210

# Search dialog input field normal color.
# Applies when the input field is not focused.
searchdialog_field_code=38;2;20;20;20;48;2;245;245;245

# Search dialog input field focused color.
# Applies when the input field has keyboard focus.
searchdialog_field_focus_code=1;38;2;255;255;255;48;2;35;135;205

# Search dialog focus color for checkboxes and history selection.
searchdialog_focus_code=1;38;2;0;0;0;48;2;170;225;255

# Search dialog cursor overlay color inside the input field.
searchdialog_cursor_code=1;38;2;255;255;255;48;2;220;80;40

# Search dialog normal button color.
searchdialog_button_code=1;38;2;20;20;20;48;2;235;235;235

# Search dialog focused button color.
searchdialog_button_focus_code=1;38;2;0;0;0;48;2;170;225;255

# Search dialog disabled text color.
# Applies to passive informational lines such as encoding label.
searchdialog_disabled_code=38;2;120;120;120;48;2;210;210;210

# Search dialog shadow color.
# Applies to the shadow node behind the dialog.
searchdialog_shadow_code=38;2;80;80;80;48;2;80;80;80

# Search dialog frame horizontal glyph.
searchdialog_frame_h=─

# Search dialog frame vertical glyph.
searchdialog_frame_v=│

# Search dialog frame top-left glyph.
searchdialog_frame_nw=┌

# Search dialog frame top-right glyph.
searchdialog_frame_ne=┐

# Search dialog frame bottom-left glyph.
searchdialog_frame_sw=└

# Search dialog frame bottom-right glyph.
searchdialog_frame_se=┘

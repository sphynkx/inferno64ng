# theme defaults
#
# SGR color format:
#   foreground truecolor: 38;2;R;G;B
#   background truecolor: 48;2;R;G;B
#   bold: 1
#   reset/default: 0
#
# Example:
#   1;38;2;0;0;0;48;2;170;225;255
#
# Do not use ';' for inline comments after values.

[theme]

panel_top_code=1;38;2;20;25;30;48;2;225;225;225
panel_body_code=38;2;220;230;255;48;2;20;45;90
panel_focus_code=1;38;2;0;0;0;48;2;170;225;255
panel_title_code=1;38;2;255;230;120;48;2;20;45;90
panel_marked_code=1;38;2;255;120;210;48;2;20;45;90
panel_marked_focus_code=1;38;2;220;0;0;48;2;170;225;255
menu_window_code=1;38;2;20;25;30;48;2;210;235;255
menu_focus_code=1;38;2;0;0;0;48;2;170;225;255

frame_style=1
panel_shadow=0
modal_anim_ticks=3

modal_copy_code=38;2;25;25;25;48;2;210;210;210
modal_overwrite_code=38;2;40;15;35;48;2;255;185;225
modal_frame_code=1;38;2;80;80;80;48;2;210;210;210
modal_text_code=38;2;25;25;25;48;2;210;210;210
modal_shadow_code=38;2;0;0;0;48;2;80;80;80
modal_field_code=38;2;20;20;20;48;2;245;245;245
modal_focus_code=1;38;2;0;0;0;48;2;170;225;255
modal_button_code=1;38;2;20;20;20;48;2;235;235;235
modal_button_focus_code=1;38;2;0;0;0;48;2;170;225;255

viewer_goto_window_code=38;2;20;20;20;48;2;210;210;210
viewer_goto_frame_code=1;38;2;35;35;35;48;2;210;210;210
viewer_goto_frame_h=─
viewer_goto_frame_v=│
viewer_goto_frame_nw=┌
viewer_goto_frame_ne=┐
viewer_goto_frame_sw=└
viewer_goto_frame_se=┘
viewer_goto_text_code=38;2;20;20;20;48;2;210;210;210
viewer_goto_field_code=1;38;2;255;255;255;48;2;55;160;220
viewer_goto_field_focus_code=1;38;2;255;255;255;48;2;35;135;205
viewer_goto_focus_code=1;38;2;0;0;0;48;2;170;225;255
viewer_goto_button_code=1;38;2;20;20;20;48;2;235;235;235

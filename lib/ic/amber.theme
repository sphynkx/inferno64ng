# Amber theme overrides.
# Base values are inherited from default.theme.

[theme]

panel_top_code=1;38;2;45;30;10;48;2;235;185;80
panel_body_code=38;2;255;220;150;48;2;45;30;12
panel_focus_code=1;38;2;35;24;10;48;2;255;220;80
panel_title_code=1;38;2;255;235;120;48;2;45;30;12
panel_marked_code=1;38;2;255;120;80;48;2;45;30;12
panel_marked_focus_code=1;38;2;160;20;0;48;2;255;220;80

command_bar_code=1;38;2;35;24;10;48;2;240;185;80
command_bar_active_code=1;38;2;255;255;210;48;2;170;95;20
command_bar_disabled_code=38;2;120;95;55;48;2;240;185;80
command_line_code=38;2;255;220;150;48;2;45;30;12

modal_copy_code=38;2;35;24;10;48;2;230;190;110
modal_overwrite_code=38;2;45;20;20;48;2;255;170;120
modal_frame_code=1;38;2;80;55;20;48;2;230;190;110
modal_text_code=38;2;35;24;10;48;2;230;190;110
modal_field_code=1;38;2;35;24;10;48;2;255;235;170
modal_focus_code=1;38;2;255;255;210;48;2;170;95;20
modal_button_code=1;38;2;35;24;10;48;2;245;210;130
modal_button_focus_code=1;38;2;255;255;210;48;2;170;95;20

viewer_search_match_code=1;38;2;35;24;10;48;2;255;220;80
editor_cursor_code=1;38;2;35;24;10;48;2;255;220;80


[screensaver]

# Master switch for screensaver system.
# 0 disables screensaver completely.
enabled=1

# Active screensaver implementation name.
name=flashlighter

# Idle timeout in UI ticks before screensaver starts.
# 0 disables screensaver without changing "enabled".
idle_ticks=30

[flashlighter]

# Number of simultaneous light spots.
# Recommended values: 1..3
beam_count=2

# Minimum and maximum horizontal radius of a light spot, in terminal cells.
radius_min=20
radius_max=24

# Vertical radius as percent of horizontal radius.
# 100 means a circle.
# Less than 100 makes horizontally stretched ellipses.
# Greater than 100 allows vertically stretched ellipses.
radius_y_percent_min=95
radius_y_percent_max=125

# Minimum and maximum beam movement speed per tick.
speed_min=4
speed_max=7

# Minimum and maximum beam lifetime in ticks.
# Larger values give longer, smoother trajectories.
beam_life_min=70
beam_life_max=160

# Preferred angle range for movement, in degrees.
# 0 means horizontal, 90 means vertical.
# Values around 25..65 favor natural diagonal motion.
preferred_angle_min=15
preferred_angle_max=45

# Probability in percent to choose angle from preferred range.
# Remaining probability uses the full 0..90 range.
preferred_angle_percent=76

# Parabola bend amplitude as percent of beam radius.
# Higher values produce stronger curved trajectories.
curve_min_amp_percent=18
curve_max_amp_percent=42

# Darkness of the shadowed background around the beam.
# Lower value means darker shadow.
shadow_percent=35

# Fallback SGR code used for deep shadow if source cell code
# cannot be darkened analytically.
shadow_code=38;2;80;80;80;48;2;0;0;0
